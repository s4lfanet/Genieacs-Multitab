[Unit]
Description=Peta pelanggan & ODP GenieACS
After=network-online.target genieacs-nbi.service
Wants=network-online.target

[Service]
User=USERNAME
Group=USERNAME
WorkingDirectory=/home/USERNAME/genieacs-map
Environment=HOME=/home/USERNAME
ExecStart=/usr/bin/node /home/USERNAME/genieacs-map/map.js
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
