[Unit]
Description=GenieACS Telegram bot (baca saja)
After=network-online.target genieacs-nbi.service
Wants=network-online.target

[Service]
User=USERNAME
Group=USERNAME
WorkingDirectory=/home/USERNAME/genieacs-bot
Environment=HOME=/home/USERNAME
ExecStart=/usr/bin/node /home/USERNAME/genieacs-bot/bot.js
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
